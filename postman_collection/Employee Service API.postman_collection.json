                 ],
    "event":  [
                  {
                      "script":  {
                                     "exec":  [
                                                  "const raw = pm.request.body \u0026\u0026 pm.request.body.raw;",
                                                  "if (raw \u0026\u0026 raw.includes(\"{{exampleAge0}}\")) {",
                                                  "    const payload = JSON.parse(raw.replace(/\\{\\{exampleAge\\d+\\}\\}/g, \"0\"));",
                                                  "    const employees = Array.isArray(payload) ? payload : [payload];",
                                                  "    const today = new Date();",
                                                  "",
                                                  "    employees.forEach((employee, index) =\u003e {",
                                                  "        const [day, month, year] = employee.birthDate.split(\"-\").map(Number);",
                                                  "        const currentMonth = today.getMonth() + 1;",
                                                  "        const beforeBirthday = currentMonth \u003c month || (currentMonth === month \u0026\u0026 today.getDate() \u003c day);",
                                                  "        const age = today.getFullYear() - year - Number(beforeBirthday);",
                                                  "        pm.variables.set(\"exampleAge\" + index, String(age));",
                                                  "    });",
                                                  "}"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "prerequest"
                  }
              ]
